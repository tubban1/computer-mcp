PORT=8787

# Absolute paths only, comma-separated. Keep this as narrow as practical.
ALLOWED_DIRECTORIES=/Users/yourname/Documents/Projects

# Filesystem writes are enabled by default. Set false to force read-only mode.
ALLOW_WRITE=true

# High-risk capabilities are off by default.
ALLOW_DELETE=false
ALLOW_SHELL=false
ALLOW_GIT_PUSH=false
ALLOW_ROLLBACK=false
ALLOW_BROWSER=false
ALLOW_GUI=false

# Privacy-aware JSONL audit log. Sensitive payloads such as file contents,
# patches, shell commands and process input are hashed/redacted.
AUDIT_LOG_ENABLED=true
# Optional override. Default: ~/.computer-mcp/audit.jsonl
# AUDIT_LOG_PATH=/Users/yourname/.computer-mcp/audit.jsonl

# Optional override for transaction metadata and staged patches.
# Default: ~/.computer-mcp/transactions
# TRANSACTION_DIR=/Users/yourname/.computer-mcp/transactions

# Browser provider (Chromium-based browser via playwright-core)
# Default mode. v0.9 callers can override headless per browser.open / web.open call.
BROWSER_HEADLESS=false
# Optional explicit browser executable. Auto-detected on macOS if omitted.
# BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional persistent browser profile. If omitted, computer-mcp uses an isolated
# runtime profile to avoid Chrome profile-lock conflicts.
# BROWSER_PROFILE_DIR=/Users/yourname/.computer-mcp/browser-profile

# macOS Desktop Perception.
# v0.9.2 prefers the standalone Computer MCP Helper.app so GUI permissions do
# not depend on whether computer-mcp was launched from Terminal, Antigravity,
# Cursor, launchd, or another parent app.
# Modes: auto (default, helper with fallback), required, disabled.
MACOS_HELPER_MODE=auto
# Default app: ~/Applications/Computer MCP Helper.app
# COMPUTER_MCP_HELPER_APP=/Users/yourname/Applications/Computer MCP Helper.app
# Default socket: ~/.computer-mcp/helper.sock
# COMPUTER_MCP_HELPER_SOCKET=/Users/yourname/.computer-mcp/helper.sock

# Persistent tasks (v0.8)
# Task definitions, runtime state, and step outputs are encrypted at rest.
# Default: ~/.computer-mcp/tasks
# TASK_DIR=/Users/yourname/.computer-mcp/tasks

# Auto-generated AES-256-GCM key. Keep this file private and backed up if
# persistent task recovery matters across machine migrations.
# Default: ~/.computer-mcp/task.key
# TASK_KEY_PATH=/Users/yourname/.computer-mcp/task.key


# Persistent task staging (v0.9.5)
# File-backed intermediate assets for durable tasks.
# Default: ~/.computer-mcp/staging
# TASK_STAGING_DIR=/Users/yourname/.computer-mcp/staging
# Automatically copy result files up to 256 MiB into staging.
# TASK_STAGING_MAX_AUTO_COPY_BYTES=268435456
# Allow filesystem/browser primitives to consume files inside the runtime-owned
# staging root. Set false if staged assets should be preservation-only.
TASK_STAGING_EXPOSE_TO_FS=true

# Persistent wake scheduler (v0.9.6)
# Encrypted schedule definitions. These are Runtime-owned internal state and are
# not automatically exposed as general filesystem roots.
# Default: ~/.computer-mcp/schedules
# SCHEDULER_DIR=/Users/yourname/.computer-mcp/schedules
# Default: ~/.computer-mcp/schedule.key
# SCHEDULER_KEY_PATH=/Users/yourname/.computer-mcp/schedule.key
# Scheduler wake poll. Default 5000 ms, bounded to 1000..60000.
# SCHEDULER_POLL_MS=5000


# Semantic Memory (v0.9.8)
# Encrypted Runtime-owned M3 store. It is not part of ALLOWED_DIRECTORIES.
# Default: ~/.computer-mcp/semantic
# SEMANTIC_MEMORY_DIR=/Users/yourname/.computer-mcp/semantic
# Default key: ~/.computer-mcp/semantic.key
# SEMANTIC_MEMORY_KEY_PATH=/Users/yourname/.computer-mcp/semantic.key
