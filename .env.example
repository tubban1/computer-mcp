PORT=8787

# Absolute paths only, comma-separated. Keep this as narrow as practical.
ALLOWED_DIRECTORIES=/Users/yourname/Documents/Projects

# Filesystem writes are enabled by default. Set false to force read-only mode.
ALLOW_WRITE=true

# Destructive filesystem deletion is off by default.
ALLOW_DELETE=false

# Arbitrary shell/process execution is off by default because it is NOT sandboxed
# by ALLOWED_DIRECTORIES. When enabled, commands can access anything your macOS
# user account can access.
ALLOW_SHELL=false

# Git push is a separate remote side effect and is off by default.
ALLOW_GIT_PUSH=false
