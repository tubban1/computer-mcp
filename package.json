{
  "name": "computer-mcp",
  "version": "0.9.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "verify:isa": "tsx scripts/verify-primitive-isa.ts",
    "verify:skill-abi": "tsx scripts/verify-skill-abi.ts",
    "verify:task-memory": "tsx scripts/verify-task-memory.ts",
    "verify:scheduler": "tsx scripts/verify-scheduler.ts",
    "verify:loop": "tsx scripts/verify-loop.ts",
    "verify:semantic-memory": "tsx scripts/verify-semantic-memory.ts",
    "verify:recall": "tsx scripts/verify-recall.ts",
    "verify:session-adapters": "tsx scripts/verify-session-adapters.ts",
    "verify:identity": "tsx scripts/verify-runtime-identity.ts",
    "verify:embedding-provider": "tsx scripts/verify-embedding-provider.ts",
    "verify:wechat-session": "tsx scripts/verify-wechat-session.ts",
    "verify:macos-helper": "xcrun swiftc -frontend -parse macos-helper/ComputerMCPHelper.swift"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "playwright-core": "^1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
